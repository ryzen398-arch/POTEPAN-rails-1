<%= render "shared/header" %>

<div class="app-body">
  <p class="new-title">予定の新規追加</p>

  <div class="form-card">
    <%= form_with model: @post do |f| %>
      <div class="form-group">
        <%= f.label :title, "タイトル", class: "form-label required" %>
        <%= f.text_field :title, class: "form-control", placeholder: "タイトル" %>
      </div>

      <div class="form-row">
        <div class="form-group">
          <%= f.label :start_date, "開始日", class: "form-label required" %>
          <%= f.date_field :start_date, class: "form-control" %>
        </div>
        <div class="form-group">
          <%= f.label :end_date, "終了日", class: "form-label required" %>
          <%= f.date_field :end_date, class: "form-control" %>
          <% if @post.errors[:end_date].any? %>
            <p class="field-error"><%= @post.errors[:end_date].first %></p>
          <% end %>
        </div>
      </div>

      <div class="form-check-group">
        <%= f.check_box :all_day, class: "form-check-input" %>
        <%= f.label :all_day, "終日の場合はチェックを入れます", class: "form-check-label" %>
      </div>

      <div class="form-group">
        <%= f.label :memo, "スケジュールメモ", class: "form-label" %>
        <%= f.text_area :memo, class: "form-control form-textarea", placeholder: "メモを入力する" %>
      </div>

      <div class="form-actions">
        <%= link_to "キャンセル", posts_path, class: "btn btn-outline-secondary" %>
        <%= f.submit "保存", class: "btn btn-primary" %>
      </div>

    <% end %>
  </div>
</div>